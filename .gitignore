# Dados sensíveis — nunca versionar
certs/*
!certs/.gitkeep
*.pfx
*.p12
.env
# Lista real de condomínios (dados de clientes). O exemplo é versionado.
config/condominios.xlsx
~$*.xlsx
.~lock.*#

# Perfil do navegador do antigo login assistido (pode conter cookies)
