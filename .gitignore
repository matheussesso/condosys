.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.coverage
htmlcov/

# Editores / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

