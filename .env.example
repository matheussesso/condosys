# Configurações do condosys. Copie para .env (o comando `condosys init` faz isso).
# Nunca coloque senhas de certificado aqui: elas ficam no cofre do sistema (keyring).

# Pastas (relativas à pasta do projeto)
CONDOSYS_CERTS_DIR=certs
CONDOSYS_CONFIG_FILE=config/condominios.xlsx
CONDOSYS_OUTPUT_DIR=output
CONDOSYS_LOGS_DIR=logs
CONDOSYS_DEBUG_DIR=debug

# Nível de log no terminal: DEBUG, INFO, WARNING, ERROR
CONDOSYS_LOG_LEVEL=INFO

# Automação do portal ISSNet: DESLIGADA. O iHub bloqueou acesso automatizado e pediu o
# uso do webservice (ADR-010). Só ligue se o suporte do portal autorizar por escrito.
CONDOSYS_ISSNET_AUTOMATION_AUTHORIZED=false

# Login no portal
# assisted  = uma pessoa faz o login no Chrome/Edge comum (certificado instalado com
#             `condosys cert install`) e o condosys assume depois (padrão; ADR-009)
# automatic = navegador do Playwright com o .pfx (bloqueado hoje pelo Cloudflare do iHub)
CONDOSYS_LOGIN_MODE=assisted
# Caminho do Chrome/Edge (vazio = procurar pelo CONDOSYS_BROWSER_CHANNEL)
# CONDOSYS_ASSISTED_BROWSER_PATH=
CONDOSYS_ASSISTED_LOGIN_TIMEOUT_MS=300000

# Navegador
# Login assistido: chrome / msedge escolhem o navegador instalado; chromium = o primeiro
#   encontrado (Windows: Edge, Chrome; Linux: Chrome, Chromium, Edge)
# Login automático: chromium = baixado com `uv run playwright install chromium`
CONDOSYS_BROWSER_CHANNEL=chromium
# Mantenha false: em modo invisível o Cloudflare bloqueia os scripts de login do portal.
CONDOSYS_HEADLESS=false
CONDOSYS_TIMEOUT_MS=30000
CONDOSYS_NAVIGATION_TIMEOUT_MS=60000
# Tempo para a pessoa marcar "Confirme que é humano" (Cloudflare) na janela do iHub
CONDOSYS_HUMAN_CHECK_TIMEOUT_MS=180000
# Pausa entre ações no navegador e entre condomínios (respeitar o portal)
CONDOSYS_SLOW_MO_MS=300
CONDOSYS_BETWEEN_CONDOMINIUMS_MS=3000

# Portal ISSNet DF
CONDOSYS_ISSNET_LOGIN_URL=https://iss.fazenda.df.gov.br/online/Login/Login.aspx?ReturnUrl=%2fonline
# Origens que recebem o certificado (JSON). O login do ISSNet abre um popup em
# api.ihub.com.br, que pede o certificado no handshake TLS. Ajuste se o portal mudar.
CONDOSYS_ISSNET_CERT_ORIGINS=["https://api.ihub.com.br"]
# API do Ambiente de Dados Nacional da NFS-e (acesso DIRETO)
CONDOSYS_ADN_BASE_URL=https://adn.nfse.gov.br
# Pausa entre lotes de 50 documentos e máximo de lotes por execução
CONDOSYS_ADN_PAUSE_MS=1000
CONDOSYS_ADN_MAX_BATCHES=100
# Recodifica o .pfx em memória (AES) antes de entregar ao navegador
CONDOSYS_REENCODE_PFX=true
