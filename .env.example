# Configurações do condosys. Copie para .env (o `condosys init` faz isso) e ajuste.
# Nenhuma senha vai aqui: as senhas dos certificados ficam no cofre do sistema.

# Pastas (relativas à pasta do projeto)
CONDOSYS_CERTS_DIR=certs
CONDOSYS_CONFIG_FILE=config/condominios.xlsx
CONDOSYS_OUTPUT_DIR=output
CONDOSYS_DATA_DIR=data
CONDOSYS_LOGS_DIR=logs
CONDOSYS_DEBUG_DIR=debug

# Nível de log no terminal: DEBUG, INFO, WARNING, ERROR
CONDOSYS_LOG_LEVEL=INFO

# API do Ambiente de Dados Nacional da NFS-e (notas tomadas)
CONDOSYS_ADN_BASE_URL=https://adn.nfse.gov.br
# Pausa entre lotes de 50 documentos e máximo de lotes por execução
CONDOSYS_ADN_PAUSE_MS=1000
CONDOSYS_ADN_MAX_BATCHES=100
# Pausa entre um condomínio e outro na coleta em lote
CONDOSYS_BETWEEN_CONDOMINIUMS_MS=1000

# API local usada pela interface (Electron); só aceita conexões desta máquina
CONDOSYS_API_HOST=127.0.0.1
CONDOSYS_API_PORT=8765
